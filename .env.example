# =============================================================
# Bold Calculator — environment variables
#
# All NEXT_PUBLIC_* values are READ AT BUILD TIME by Next.js and
# inlined into the client JS bundle. They MUST be available
# during `next build`. In Coolify: enable "Available at Buildtime"
# for each one.
#
# There are NO runtime-only secrets in this project. PORT and
# HOSTNAME are hardcoded in the Dockerfile.
# =============================================================

# Supabase project URL (build-time)
# Example: https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key (build-time, safe to expose; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App version label (build-time, optional, cosmetic)
NEXT_PUBLIC_APP_VERSION=1.0.0
